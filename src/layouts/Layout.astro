---
import '../styles/global.css';
import '../styles/futuristic.css';
import '../styles/luxury.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title, description } = Astro.props;
---
<!doctype html><html lang="en"><head><script is:inline>document.documentElement.classList.add("js");</script><SeoHead title={title} description={description} /><slot name="head" /></head><body id="top"><div class="bg-aurora" aria-hidden="true"><div class="aurora-c"></div></div><canvas class="bg-mesh" aria-hidden="true"></canvas><div class="bg-grid" aria-hidden="true"></div><div class="grain" aria-hidden="true"></div><Header /><main id="main"><slot /></main><Footer /><script>
(function () {
  var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  var hasIO = 'IntersectionObserver' in window;

  // Scroll reveal
  var revealEls = document.querySelectorAll('.reveal');
  if (reduce || !hasIO) {
    revealEls.forEach(function (el) { el.classList.add('is-visible'); });
  } else {
    var ro = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-visible'); ro.unobserve(e.target); }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    revealEls.forEach(function (el) { ro.observe(el); });
  }

  // Animated counters
  var counterEls = document.querySelectorAll('[data-count]');
  if (reduce || !hasIO) {
    counterEls.forEach(function (el) { el.textContent = el.getAttribute('data-count'); });
  } else {
    var co = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        co.unobserve(e.target);
        var target = parseFloat(e.target.getAttribute('data-count'));
        var dec = parseInt(e.target.getAttribute('data-decimals') || '0', 10);
        var dur = 1400, t0 = performance.now();
        function tick(now) {
          var p = Math.min((now - t0) / dur, 1);
          var eased = 1 - Math.pow(1 - p, 3);
          e.target.textContent = (target * eased).toFixed(dec);
          if (p < 1) requestAnimationFrame(tick);
          else e.target.textContent = target.toFixed(dec);
        }
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.5 });
    counterEls.forEach(function (el) { co.observe(el); });
  }

  // Cursor glow
  if (!reduce && matchMedia('(pointer: fine)').matches) {
    var glow = document.createElement('div');
    glow.className = 'cursor-glow';
    glow.setAttribute('aria-hidden', 'true');
    document.body.appendChild(glow);
    var x = -400, y = -400, tx = -400, ty = -400, raf = null;
    window.addEventListener('pointermove', function (e) {
      tx = e.clientX - 160; ty = e.clientY - 160;
      if (!raf) {
        raf = requestAnimationFrame(function () {
          x += (tx - x) * 0.18; y += (ty - y) * 0.18;
          glow.style.transform = 'translate(' + x + 'px,' + y + 'px)';
          raf = null;
        });
      }
    });
  }
})();
</script><script>
(function () {
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  // Scroll progress bar
  var prog = document.createElement('div');
  prog.className = 'scroll-progress';
  prog.setAttribute('aria-hidden', 'true');
  prog.innerHTML = '<div class="scroll-progress__bar"></div>';
  document.body.appendChild(prog);
  var bar = prog.firstChild;
  function onScroll() {
    var h = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  if (!matchMedia('(pointer: fine)').matches) return;

  // House scene follows cursor + scroll (composed parallax)
  var scene = document.querySelector('.house-scene');
  if (scene) {
    var cx = 0, cy = 0, sp = 0;
    var hero = document.querySelector('.home-hero');
    function applyScene() {
      scene.style.transform =
        'translate(' + (cx * 10) + 'px,' + (cy * 10 + sp * 46) + 'px) rotateX(' + (sp * 3) + 'deg)';
    }
    scene.addEventListener('pointermove', function (e) {
      var r = scene.getBoundingClientRect();
      cx = (e.clientX - r.left) / r.width - 0.5;
      cy = (e.clientY - r.top) / r.height - 0.5;
      applyScene();
    });
    scene.addEventListener('pointerleave', function () { cx = 0; cy = 0; applyScene(); });
    if (hero) {
      window.addEventListener('scroll', function () {
        var y = window.scrollY, h = hero.offsetHeight;
        sp = y < h ? y / h : 1;
        applyScene();
      }, { passive: true });
    }
  }

  // Magnetic tilt on service cards
  document.querySelectorAll('.service-card').forEach(function (el) {
    el.setAttribute('data-tilt', '5');
    el.addEventListener('pointermove', function (e) {
      var r = el.getBoundingClientRect();
      var px = (e.clientX - r.left) / r.width - 0.5;
      var py = (e.clientY - r.top) / r.height - 0.5;
      el.style.transform = 'perspective(700px) rotateY(' + (px * 6) + 'deg) rotateX(' + (-py * 6) + 'deg) translateY(-5px)';
    });
    el.addEventListener('pointerleave', function () { el.style.transform = ''; });
  });

  // Stat glow pulse when the number lands
  var statIO = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        var t = e.target;
        t.classList.add('is-pulse');
        setTimeout(function () { t.classList.remove('is-pulse'); }, 900);
        statIO.unobserve(t);
      }
    });
  }, { threshold: 0.6 });
  document.querySelectorAll('.stat strong').forEach(function (s) { statIO.observe(s); });
})();
</script><script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { SplitText } from 'gsap/SplitText';
import Lenis from 'lenis';

gsap.registerPlugin(ScrollTrigger, SplitText);
const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

// 1. Lenis smooth scroll — the "scroll-motion" momentum feel
let lenis;
if (!reduce) {
  lenis = new Lenis({ duration: 1.15, smoothWheel: true });
  lenis.on('scroll', ScrollTrigger.update);
  gsap.ticker.add((t) => lenis.raf(t * 1000));
  gsap.ticker.lagSmoothing(0);

  document.querySelectorAll('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const href = a.getAttribute('href');
      if (href && href.length > 1) {
        const el = document.querySelector(href);
        if (el) { e.preventDefault(); lenis.scrollTo(el, { offset: -130, duration: 1.4 }); }
      }
    });
  });
}

// 2. Kinetic typography — headline words rise in with stagger + blur
const h1 = document.querySelector('.home-hero h1');
if (h1 && !reduce) {
  gsap.set(h1, { opacity: 1 });
  const split = new SplitText(h1, { type: 'words', wordsClass: 'kt-word' });
  gsap.from(split.words, {
    opacity: 0, y: '0.85em', rotateX: -45, filter: 'blur(6px)',
    stagger: 0.055, duration: 1.05, ease: 'power4.out', delay: 0.1
  });
}

// 2b. Contact shield — slow organic spin (wandering speed, never reverses, never fast)
const pshield = document.querySelector('.phone-shield');
if (pshield && !reduce) {
  let ang = 0, vel = 15, seed = Math.random() * 1000;
  gsap.ticker.add((time, dt) => {
    vel = 15 + 8 * Math.sin(seed + time * 0.2) + 4 * Math.sin(seed * 1.3 + time * 0.09);
    ang = (ang + (vel * dt) / 1000) % 360;
    pshield.style.transform = 'rotate(' + ang + 'deg)';
  });
}

// 3. Liquid mesh gradient background (WebGL) — creative layer; falls back to CSS aurora
(function () {
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.querySelector('.bg-mesh');
  if (!canvas || reduce) return; // keep static CSS aurora under reduced-motion
  const gl = canvas.getContext('webgl', { antialias: false, depth: false, stencil: false, alpha: false, powerPreference: 'low-power' });
  if (!gl) return; // no WebGL → CSS aurora stays
  document.body.classList.add('has-mesh');

  const VERT = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
  const FRAG = `
precision mediump float;
uniform vec2 u_res; uniform float u_time;
float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453123);}
float noise(vec2 p){vec2 i=floor(p);vec2 f=fract(p);f=f*f*(3.0-2.0*f);
  return mix(mix(hash(i),hash(i+vec2(1.,0.)),f.x),mix(hash(i+vec2(0.,1.)),hash(i+vec2(1.,1.)),f.x),f.y);}
float fbm(vec2 p){float v=0.;float a=.5;for(int i=0;i<5;i++){v+=a*noise(p);p*=2.03;a*=.5;}return v;}
void main(){
  vec2 uv=gl_FragCoord.xy/u_res.xy;
  float t=u_time*0.06;
  vec2 p=uv*2.0-1.0;p.x*=u_res.x/u_res.y;
  vec2 q=vec2(fbm(p+vec2(0.,t)),fbm(p+vec2(5.2,1.3)-t));
  vec2 r=vec2(fbm(p+4.0*q+vec2(1.7,9.2)+t*0.5),fbm(p+4.0*q+vec2(8.3,2.8)-t*0.4));
  float f=fbm(p+4.0*r);
  vec3 deep=vec3(0.043,0.075,0.100);
  vec3 cyan=vec3(0.0,0.898,1.0);
  vec3 chrome=vec3(0.78,0.83,0.87);
  vec3 col=deep;
  col=mix(col,cyan,smoothstep(0.58,0.82,f)*0.42);
  col=mix(col,chrome,smoothstep(0.72,0.95,f)*0.22);
  col+=vec3(0.0,0.09,0.13)*(1.0-smoothstep(0.0,0.55,uv.y));
  col*=1.0-0.35*smoothstep(0.55,1.05,length(uv-0.5));
  gl_FragColor=vec4(col,1.0);
}`;

  function sh(type, src) {
    const s = gl.createShader(type); gl.shaderSource(s, src); gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { console.error(gl.getShaderInfoLog(s)); return null; }
    return s;
  }
  const vs = sh(gl.VERTEX_SHADER, VERT), fs = sh(gl.FRAGMENT_SHADER, FRAG);
  if (!vs || !fs) return;
  const prog = gl.createProgram();
  gl.attachShader(prog, vs); gl.attachShader(prog, fs); gl.linkProgram(prog);
  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
  gl.useProgram(prog);
  const buf = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, buf);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1,-1, 1,-1, -1,1, 1,1]), gl.STATIC_DRAW);
  const loc = gl.getAttribLocation(prog, 'p');
  gl.enableVertexAttribArray(loc); gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
  const uRes = gl.getUniformLocation(prog, 'u_res'), uTime = gl.getUniformLocation(prog, 'u_time');

  function resize() {
    const s = 0.35; // low-res render; CSS upscales the smooth noise
    const w = Math.max(2, Math.floor(innerWidth * s)), h = Math.max(2, Math.floor(innerHeight * s));
    if (canvas.width !== w || canvas.height !== h) { canvas.width = w; canvas.height = h; }
  }
  resize(); addEventListener('resize', resize);

  let raf = 0, t0 = performance.now();
  function frame(now) {
    gl.viewport(0, 0, canvas.width, canvas.height);
    gl.uniform2f(uRes, canvas.width, canvas.height);
    gl.uniform1f(uTime, (now - t0) / 1000);
    gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    raf = requestAnimationFrame(frame);
  }
  raf = requestAnimationFrame(frame);
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { cancelAnimationFrame(raf); t0 += performance.now() - (window.__meshT || performance.now()); }
    else { raf = requestAnimationFrame(frame); }
  });
})();
</script></body></html>
