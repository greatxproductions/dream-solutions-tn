---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
---
<Layout title="Contact & Free Estimate" description="Contact Dream Solutions Tennessee for a free estimate on radon testing, mitigation, or crawl space encapsulation in Nashville and Middle Tennessee."><section class="contact-section"><div><p class="eyebrow">Let’s talk about your home</p><h1>A healthier home<br />starts with a<br /><em>conversation.</em></h1><p class="hero-description">Tell us what you need. We’ll help you understand the next step.</p><div class="contact-details"><div class="contact-info"><p class="eyebrow">Give us a call</p><a class="phone-link" href="tel:+16155550123">(615) 555-0123</a><p class="eyebrow">Where we work</p><p>Nashville, TN & surrounding<br />Middle Tennessee territories</p></div><div class="phone-shield-wrap" aria-hidden="true"><img class="phone-shield" src="/brand/shield-emblem.png" width="600" height="600" alt="" /><span class="smoke-p" style="--dx:-16px;--dz:30px;left:18%"></span><span class="smoke-p smoke-p--lg" style="--dx:10px;--dz:50px;left:55%;animation-delay:-1.3s"></span><span class="smoke-p smoke-p--sm" style="--dx:-22px;--dz:-24px;left:40%;animation-delay:-2.6s"></span><span class="smoke-p" style="--dx:20px;--dz:10px;left:72%;animation-delay:-3.9s"></span><span class="smoke-p smoke-p--sm" style="--dx:-6px;--dz:-40px;left:30%;animation-delay:-5.1s"></span></div></div></div><div class="form-wrap"><h2>Get a Free Estimate</h2><p>Start with a few details about your project.</p><ContactForm /></div></section></Layout>