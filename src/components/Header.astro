---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [['/radon-testing','Testing'],['/radon-mitigation','Mitigation'],['/crawl-space-encapsulation','Crawl spaces'],['/about','About']];
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><a class="wordmark" href="/" aria-label="Dream Solutions Tennessee home"><img class="brand-emblem" src="/brand/shield-emblem.png" width="54" height="54" alt="" /><span class="brand-copy"><span class="brand-name">DREAM SOLUTIONS</span><span class="brand-region">TENNESSEE</span><span class="brand-tagline">Prescribing Clean Air For Your Home</span></span></a><nav aria-label="Main navigation">{links.map(([href,label]) => <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>)}</nav><a class="header-cta" href="/contact">Free estimate <span aria-hidden="true">↗</span></a></header>
