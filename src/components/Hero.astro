---
const { eyebrow, title, description, home = false } = Astro.props;
---
<section class:list={['hero', { 'home-hero': home }]}><div class="hero-copy"><p class="eyebrow">{eyebrow}</p><h1 set:html={title} /><p class="hero-description">{description}</p><a class="button" href="/contact">Get a Free Estimate <span aria-hidden="true">↗</span></a></div>{home && <div class="house-art"><svg viewBox="0 0 600 560" role="img" aria-label="Architectural illustration of a home and the ground beneath it"><defs><pattern id="soil" width="18" height="18" patternUnits="userSpaceOnUse"><path d="M2 15l3-3m7-6 2-2" stroke="#c9a86a" stroke-width=".6" /></pattern></defs><circle cx="306" cy="245" r="203" fill="none" stroke="#0e7c86" stroke-width=".6"/><path d="M49 375H553M79 399H524M109 423H496" stroke="#7fa8ad" stroke-width=".6"/><path d="M144 354V219L302 96l158 123v135M117 224L302 78l185 146M302 96v258M144 354h316M176 354V240h87v114M339 241h85v67h-85zM380 241v67M339 274h85M191 147v-44h35v17" fill="none" stroke="#2a6b74" stroke-width="1.2"/><path d="M145 367h315v89H145z" fill="url(#soil)"/><path d="M310 446V364h-38V238M272 238V148" fill="none" stroke="#0f3d4a" stroke-width="3"/><path d="M293 163l-21-20-21 20M297 422l13-13 13 13" fill="none" stroke="#0f3d4a" stroke-width="1.5"/><circle cx="272" cy="219" r="10" fill="#e56b4f" stroke="#0f3d4a"/><path d="M471 292h57M461 354h67" stroke="#7fa8ad" stroke-width=".7"/></svg><p class="art-caption"><span>Built around your home.</span><span>Focused on the air within.</span></p></div>}</section>
