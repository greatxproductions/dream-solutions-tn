---
const { eyebrow, title, description, home = false } = Astro.props;
---
<section class:list={['hero', { 'home-hero': home }]}><div class="hero-copy"><p class="eyebrow">{eyebrow}</p><h1 set:html={title} /><p class="hero-description">{description}</p><a class="button" href="/contact">Get a Free Estimate <span aria-hidden="true">↗</span></a></div>{home && <div class="house-art"><div class="float-shape" style="width:150px;height:150px;top:5%;left:6%;background:radial-gradient(circle,rgba(0,229,255,0.18),transparent 70%)" aria-hidden="true"></div><div class="float-shape" style="width:95px;height:95px;top:26%;right:2%;background:radial-gradient(circle,rgba(200,211,221,0.24),transparent 70%);animation-delay:-5s" aria-hidden="true"></div><div class="float-shape" style="width:65px;height:65px;bottom:20%;left:18%;background:radial-gradient(circle,rgba(110,197,232,0.2),transparent 70%);animation-delay:-9s" aria-hidden="true"></div><img src="/brand/shield-emblem.png" width="1254" height="1254" alt="Dream Solutions Tennessee — DS shield emblem" fetchpriority="high" /><p class="art-caption"><span>Built around your home.</span><span>Focused on the air within.</span></p></div>}</section>
